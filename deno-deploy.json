{
  "runtime": {
    "type": "deno"
  },
  "deploy": {
    "project": "walletx",
    "entrypoint": "jsr:@deno/nextjs-start",
    "exclude": [
      "node_modules",
      ".vscode",
      ".git"
    ],
    "include": [
      ".next/**/*",
      "public/**/*"
    ],
    "staticAssets": {
      "paths": [
        ".next/static/**/*.woff",
        ".next/static/**/*.woff2",
        ".next/static/**/*.ttf",
        ".next/static/**/*.eot",
        ".next/static/**/*.otf",
        ".next/static/**/*.jpg",
        ".next/static/**/*.jpeg",
        ".next/static/**/*.png",
        ".next/static/**/*.gif",
        ".next/static/**/*.ico",
        ".next/static/**/*.svg",
        "public/**/*"
      ]
    }
  }
} 