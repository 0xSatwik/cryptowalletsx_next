{
  "project": "walletx",
  "entrypoint": "jsr:@deno/nextjs-start",
  "import_map": "./import_map.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "static": {
    "include": [
      ".next/static/**/*",
      "public/**/*"
    ],
    "exclude": [
      "node_modules/**/*",
      ".git/**/*"
    ]
  },
  "binaryMediaTypes": [
    "application/font-woff",
    "application/font-woff2",
    "font/woff",
    "font/woff2",
    "font/ttf",
    "font/otf",
    "font/eot",
    "image/jpeg",
    "image/png",
    "image/gif",
    "image/svg+xml"
  ],
  "supportedExtensions": [
    ".js",
    ".json",
    ".jsx",
    ".ts",
    ".tsx",
    ".md",
    ".html",
    ".css",
    ".woff",
    ".woff2",
    ".ttf",
    ".eot",
    ".otf",
    ".jpg",
    ".jpeg",
    ".png",
    ".gif",
    ".svg"
  ]
} 