{
  "tasks": {
    "dev": "deno run -A --watch=static/,routes/ dev.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "importMap": "./import_map.json",
  "fmt": {
    "files": {
      "exclude": [".next", "node_modules"]
    }
  },
  "deploy": {
    "exclude": [
      "node_modules",
      ".vscode",
      ".git"
    ],
    "static": {
      "includes": [
        ".next/static/**/*",
        "public/**/*"
      ]
    }
  }
} 